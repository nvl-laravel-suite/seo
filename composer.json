{
    "name": "nvl/seo",
    "description": "Localized SEO metadata, canonical URLs, social previews, structured data, robots, and sitemaps for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "seo",
        "sitemap",
        "robots",
        "opengraph",
        "json-ld",
        "translation"
    ],
    "require": {
        "ext-filter": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-xmlwriter": "*",
        "laravel/framework": "^12.0 || ^13.0",
        "nesbot/carbon": "^2.72 || ^3.0",
        "nvl/core": "^6.0.1",
        "nvl/translatable": "^6.0",
        "php": "^8.4",
        "spatie/laravel-data": "^4.23",
        "symfony/http-foundation": "^7.0 || ^8.0",
        "symfony/http-kernel": "^7.2 || ^8.0"
    },
    "require-dev": {
        "ext-pdo": "*",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nvl/content": "^6.0",
        "nvl/media": "^6.0",
        "nvl/ownership": "^6.0.1",
        "nvl/tenancy": "^6.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "spatie/typescript-transformer": "^3.3"
    },
    "autoload": {
        "psr-4": {
            "Nvl\\Seo\\": "src/",
            "Nvl\\Seo\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvl\\Seo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "format": "pint --parallel --format agent",
        "format:test": "pint --parallel --test --format agent",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "pest --compact"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "6.x-dev"
        },
        "laravel": {
            "providers": [
                "Nvl\\Seo\\Providers\\SeoServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.temp",
            "/build",
            "/coverage",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/tests",
            "/.DS_Store",
            "/**/.DS_Store",
            "/.gitattributes",
            "/**/.gitattributes",
            "/.gitignore",
            "/**/.gitignore",
            "/**/.gitkeep"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "nvl/ownership": "Adds optional model-declared ownership, isolation, adoption and captured worker contexts.",
        "nvl/tenancy": "Temporary legacy tenancy bridge for existing tenant installations; native ownership does not require it.",
        "spatie/typescript-transformer": "Consume the declared TypeScript attributes and metadata (^3.3); Core retains the runtime transformation engine."
    },
    "conflict": {
        "nvl/ownership": "<6.0.1 || >=7.0",
        "nvl/tenancy": "<6.0 || >=7.0"
    },
    "homepage": "https://github.com/nvl-laravel-suite/seo",
    "authors": [
        {
            "name": "Nicolas Vlachos",
            "homepage": "https://github.com/nicolasvlachos",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/nvl-laravel-suite/seo",
        "docs": "https://github.com/nvl-laravel-suite/seo#readme",
        "issues": "https://github.com/nvl-laravel-suite/seo/issues",
        "security": "https://github.com/nvl-laravel-suite/seo/security/policy"
    }
}
